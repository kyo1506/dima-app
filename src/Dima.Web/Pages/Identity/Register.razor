@page "/register"
@layout HeadlessLayout

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="12" md="8" lg="6">
        <MudPaper Class="mud-width-full pa-8">
            <div class="d-flex justify-center pb-8 pt-8">
                <MudImage Src="imgs/dima.png" Alt="Dima - Finance Control" Width="200" />
            </div>
            
            <MudForm @ref="_mudForm" Model="InputModel" @bind-IsValid="_isValid">
                <MudTextField T=string Label="Email" Required="true" InputType="InputType.Email"
                              For="@(() => InputModel.Email)" @bind-Value="InputModel.Email" />

                <MudTextField T=string Label="Password" Required="true" InputType="InputType.Password"
                              For="@(() => InputModel.Password)" @bind-Value="InputModel.Password" />

                <MudTextField T=string Label="Confirm Password" Required="true" InputType="InputType.Password"
                              For="@(() => InputModel.ConfirmPassword)" @bind-Value="InputModel.ConfirmPassword" />
            </MudForm>

            <div class="d-flex mt-8">
                @if (IsBusy)
                {
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                }
                else
                {
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="@(!_isValid)" OnClick="OnValidSubmitAsync">Create Account
                    </MudButton>
                    <MudSpacer />
                    <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Secondary">Already have an account?
                    </MudButton>
                }
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>