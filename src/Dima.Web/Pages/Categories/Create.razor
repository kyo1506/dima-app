@page "/categories/create"
@inherits CreateCategoryPage

<MudText Typo="Typo.h3">Create Category</MudText>
<MudPaper Class="pa-8 mt-4">
    <MudForm @ref="_mudForm" Model="@InputModel" @bind-IsValid="_isValid">
        <MudTextField T=string Label="Title" Required="true" InputType="InputType.Text" For="@(() => InputModel.Title)"
                      @bind-Value="InputModel.Title" />

        <MudTextField T=string Label="Description" Lines="5" InputType="InputType.Text" For="@(() => InputModel.Description)"
                      @bind-Value="InputModel.Description" />

        <div class="d-flex mt-4">
            @if (IsBusy)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(!_isValid)" OnClick="HandleValidSubmitAsync">Save</MudButton>
                <MudSpacer />
                <MudButton Href="/categories" Variant="Variant.Text">Cancel</MudButton>
            }
        </div>
    </MudForm>
</MudPaper>