@page "/transactions/create"
@inherits CreateTransactionPage
@using Dima.Core.Enums

<MudText Typo="Typo.h3">Create Transaction</MudText>
<MudPaper Class="pa-8 mt-4">
    <MudForm @ref="_mudForm" Model="@InputModel" @bind-IsValid="_isValid">
        <MudTextField T="string" Label="Title" Required="true" InputType="InputType.Text"
                      For="@(() => InputModel.Title)" @bind-Value="InputModel.Title" />

        <MudTextField T="decimal" Label="Amount" Required="true" InputType="InputType.Number" Format="C"
                      For="@(() => InputModel.Amount)" @bind-Value="InputModel.Amount" />

        <MudDatePicker Label="When?" @bind-Date="@InputModel.PaidOrReceivedAt"
                       HelperText="Select the date when the transaction occurred" />

        <MudSelect T="ETransactionType" Label="Transaction Type" Required="true" For="@(() => InputModel.Type)"
                   @bind-Value="InputModel.Type" AnchorOrigin="Origin.BottomCenter">
            @foreach (var type in Enum.GetValues<ETransactionType>())
            {
                <MudSelectItem Value="@type">@type.ToString()</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="long" Label="Category" Required="true" For="@(() => InputModel.CategoryId)"
                   @bind-Value="InputModel.CategoryId" AnchorOrigin="Origin.BottomCenter">
            @foreach (var category in _categories)
            {
                <MudSelectItem Value="@category.Id">@category.Title</MudSelectItem>
            }
        </MudSelect>

        <div class="d-flex mt-4">
            @if (IsBusy)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(!_isValid)" OnClick="HandleValidSubmitAsync">Save</MudButton>
                <MudSpacer />
                <MudButton Href="/transactions" Variant="Variant.Text">Cancel</MudButton>
            }
        </div>
    </MudForm>
</MudPaper>
